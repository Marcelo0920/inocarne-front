# URL base de la API.
#
# En desarrollo se deja vacía: Vite redirige /api a http://localhost:4000.
# Para producción no hace falta tocarla aquí: el valor vive en
# `.env.production`, que Vite usa al compilar y que sí está versionado porque
# es una dirección pública, no un secreto.
VITE_API_URL=https://inocarne.onrender.com
